{
  "_meta": {
    "version": "1.0.0",
    "description": "Adult reference intervals used by the deterministic classifier. Illustrative values consistent with common clinical laboratory adult intervals; NOT a substitute for the issuing laboratory's own intervals.",
    "range_semantics": "low/high are inclusive bounds of the Normal interval, expressed in canonical_unit.",
    "panic_semantics": "panic.low / panic.high are absolute action limits. Breaching one forces status=Critical regardless of the deviation index.",
    "units_semantics": "units maps an accepted input unit to the multiplier that converts it INTO canonical_unit.",
    "critical_band_semantics": "critical_band is the deviation index (interval widths outside the reference interval) at which a result escalates from Warning to Critical. Defaults to 1.0. Tests with a narrow physiological interval but a wide clinically tolerable range carry a larger band."
  },
